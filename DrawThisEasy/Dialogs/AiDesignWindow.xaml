<Window x:Class="DrawThisEasy.Dialogs.AiDesignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Width="600" SizeToContent="Height">
  <Border Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="#0F172A" Opacity="0.35" BlurRadius="40" ShadowDepth="6"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Header -->
      <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseDown" Background="Transparent">
        <Grid Margin="18,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" Margin="0,0,10,0">
            <Path Data="M12,2 L14.2,9.8 L22,12 L14.2,14.2 L12,22 L9.8,14.2 L2,12 L9.8,9.8 Z" Fill="{StaticResource AccentStrongBrush}"
                  Stretch="Uniform" Width="16" Height="16"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Text="Design with AI" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock x:Name="SubtitleText" Text="Describe a diagram and AI draws it with DrawThisEasy shapes." FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
          </StackPanel>
          <Button Grid.Column="2" x:Name="BtnClose" Style="{StaticResource IconButton}" Click="Close_Click" Content="✕" FontSize="14" Foreground="{StaticResource TextMutedBrush}"/>
        </Grid>
      </Border>

      <!-- Body -->
      <StackPanel Grid.Row="1" Margin="18,14,18,16">
        <TextBlock x:Name="LblEngine" Text="ENGINE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ComboBox Grid.Column="0" x:Name="CmbProvider" Height="30" VerticalContentAlignment="Center" SelectionChanged="CmbProvider_SelectionChanged"/>
          <ComboBox Grid.Column="1" x:Name="CmbModel" Height="30" Margin="8,0,0,0" VerticalContentAlignment="Center" IsEditable="True"/>
          <Button Grid.Column="2" x:Name="BtnSettings" Content="Settings…" Style="{StaticResource GhostButton}" Click="Settings_Click"
                  Margin="8,0,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinWidth="86"/>
        </Grid>

        <TextBlock x:Name="LblPrompt" Text="WHAT SHOULD I DRAW?" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
        <Grid>
          <TextBox x:Name="PromptBox" Height="130" Padding="10,8" FontFamily="Segoe UI" FontSize="13" TextWrapping="Wrap" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource TextBrush}"
                   TextChanged="PromptBox_TextChanged" PreviewKeyDown="PromptBox_PreviewKeyDown"/>
          <TextBlock x:Name="PromptHint" IsHitTestVisible="False" Margin="13,9,13,0" TextWrapping="Wrap" FontSize="13"
                     Foreground="#FF94A3B8" Text="e.g. An e-commerce architecture on AWS with CloudFront, API Gateway, Lambda, DynamoDB and an SQS order queue"/>
        </Grid>

        <TextBlock x:Name="LblExamples" Text="Try:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,4"/>
        <WrapPanel x:Name="ExamplePanel"/>

        <CheckBox x:Name="ChkEditCurrent" Content="Modify the current diagram instead of drawing a new one" Margin="0,12,0,0" Foreground="{StaticResource TextBrush}"/>

        <!-- Status -->
        <Border x:Name="StatusCard" Visibility="Collapsed" Margin="0,14,0,0" Padding="12,10" CornerRadius="8" Background="{StaticResource AccentSoftBrush}">
          <StackPanel>
            <TextBlock x:Name="StatusText" Text="Designing…" FontSize="12.5" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="4" Margin="0,8,0,0" Foreground="{StaticResource AccentBrush}" Background="#FFBAE6FD" BorderThickness="0"/>
          </StackPanel>
        </Border>
        <Border x:Name="ErrorCard" Visibility="Collapsed" Margin="0,14,0,0" Padding="12,10" CornerRadius="8" Background="#FFFEF2F2" BorderBrush="#FFFECACA" BorderThickness="1">
          <TextBlock x:Name="ErrorText" FontSize="12.5" Foreground="#FFB91C1C" TextWrapping="Wrap"/>
        </Border>
      </StackPanel>

      <!-- Footer -->
      <Border Grid.Row="2" Background="#FFF8FAFC" CornerRadius="0,0,12,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
        <DockPanel Margin="18,10,12,10">
          <TextBlock x:Name="ShortcutHint" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="Ctrl+Enter to generate"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource GhostButton}" Click="Cancel_Click" MinWidth="92" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0"/>
            <Button x:Name="BtnGenerate" Content="Generate" Style="{StaticResource PrimaryButton}" Click="Generate_Click" MinWidth="110"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
