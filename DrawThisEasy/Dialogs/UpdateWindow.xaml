<Window x:Class="DrawThisEasy.Dialogs.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Width="520" SizeToContent="Height">
  <Border Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="#0F172A" Opacity="0.35" BlurRadius="40" ShadowDepth="6"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="18,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" x:Name="TitleText" Text="Update available" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
          <Button Grid.Column="1" x:Name="BtnClose" Style="{StaticResource IconButton}" Click="Later_Click" Content="✕" FontSize="14" Foreground="{StaticResource TextMutedBrush}"/>
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="18,14,18,16">
        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontSize="13.5" Foreground="{StaticResource TextBrush}" LineHeight="20"/>
        <TextBlock x:Name="LblNotes" Text="WHAT'S NEW" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,14,0,6"/>
        <TextBox x:Name="NotesBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 MaxHeight="220" MinHeight="80" Padding="8,6" FontSize="12.5"
                 Foreground="{StaticResource TextBrush}" Background="#FFF8FAFC" BorderBrush="{StaticResource BorderBrush}"/>
        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,14,0,0">
          <TextBlock x:Name="ProgressText" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
          <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="1"
                       Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource DangerBrush}" Margin="0,10,0,0"/>
      </StackPanel>

      <Border Grid.Row="2" Background="#FFF8FAFC" CornerRadius="0,0,12,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
        <DockPanel Margin="12,10">
          <Button x:Name="BtnSkip" DockPanel.Dock="Left" Content="Skip this version" Style="{StaticResource GhostButton}" Click="Skip_Click"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnLater" Content="Later" Style="{StaticResource GhostButton}" Click="Later_Click" MinWidth="92" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0"/>
            <Button x:Name="BtnInstall" Content="Download &amp; install" Style="{StaticResource PrimaryButton}" Click="Install_Click" MinWidth="140"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
