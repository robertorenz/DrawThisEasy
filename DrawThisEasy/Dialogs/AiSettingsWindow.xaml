<Window x:Class="DrawThisEasy.Dialogs.AiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Width="520" SizeToContent="Height">
  <Border Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="#0F172A" Opacity="0.35" BlurRadius="40" ShadowDepth="6"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="18,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="TitleText" Text="AI Settings" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="Close_Click" Content="✕" FontSize="14" Foreground="{StaticResource TextMutedBrush}"/>
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="18,14,18,16">
        <TextBlock x:Name="LblProvider" Text="DEFAULT ENGINE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
        <StackPanel x:Name="ProviderList"/>

        <Border Background="{StaticResource BorderBrush}" Height="1" Margin="0,12"/>

        <!-- Claude subscription (Claude Code CLI) -->
        <TextBlock x:Name="LblCodeHeader" Text="CLAUDE SUBSCRIPTION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
        <TextBlock x:Name="LblCliPath" Text="Claude Code CLI path (blank = auto-detect)" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
        <DockPanel>
          <Button x:Name="BtnBrowse" DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource GhostButton}" Click="Browse_Click"
                  Margin="8,0,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinWidth="80"/>
          <TextBox x:Name="TxtCliPath" Height="30" Padding="6,4" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="12" TextChanged="TxtCliPath_TextChanged"/>
        </DockPanel>
        <TextBlock x:Name="CliStatus" FontSize="11.5" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>

        <Border Background="{StaticResource BorderBrush}" Height="1" Margin="0,12"/>

        <!-- Claude API -->
        <TextBlock x:Name="LblApiHeader" Text="CLAUDE API" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
        <TextBlock x:Name="LblApiKey" Text="API key" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
        <PasswordBox x:Name="TxtApiKey" Height="30" Padding="6,4" VerticalContentAlignment="Center" FontSize="12"/>
        <TextBlock x:Name="ApiKeyNote" FontSize="11.5" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>

        <Border x:Name="TestCard" Visibility="Collapsed" Margin="0,12,0,0" Padding="12,9" CornerRadius="8">
          <TextBlock x:Name="TestText" FontSize="12" TextWrapping="Wrap"/>
        </Border>
      </StackPanel>

      <Border Grid.Row="2" Background="#FFF8FAFC" CornerRadius="0,0,12,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
        <DockPanel Margin="12,10">
          <Button x:Name="BtnTest" DockPanel.Dock="Left" Content="Test connection" Style="{StaticResource GhostButton}" Click="Test_Click"
                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinWidth="120"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource GhostButton}" Click="Close_Click" MinWidth="92" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0"/>
            <Button x:Name="BtnSave" Content="Save" Style="{StaticResource PrimaryButton}" Click="Save_Click" MinWidth="92"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
